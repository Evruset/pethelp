PORT=3000
DATABASE_URL=postgres://vethelp:vethelp@localhost:5432/vethelp
HOLD_TTL_MINUTES=10
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20
WORKERS_ENABLED=true
SWAGGER_ENABLED=true
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_OTP_PEPPER=replace-with-a-separate-high-entropy-otp-pepper
AUTH_OTP_PEPPER_VERSION=v1
OWNER_PET_IDEMPOTENCY_HMAC_KEY=replace-with-a-stable-distinct-32-byte-key-never-rotated-before-pet-ledger-deletion
AUTH_OTP_ANTI_FRAUD_PEPPER=replace-with-a-distinct-high-entropy-anti-fraud-pepper
AUTH_OTP_ANTI_FRAUD_PEPPER_VERSION=v1
# Rotation is coordinated/non-rolling: all replicas switch together; retain PREVIOUS for at least 25h.
# AUTH_OTP_ANTI_FRAUD_PREVIOUS_PEPPER=
# AUTH_OTP_ANTI_FRAUD_PREVIOUS_PEPPER_VERSION=
AUTH_OTP_PHONE_HOURLY_LIMIT=5
AUTH_OTP_PHONE_DAILY_LIMIT=10
AUTH_OTP_IP_HOURLY_LIMIT=20
AUTH_OTP_INITIAL_BLOCK_SECONDS=900
AUTH_OTP_ESCALATED_BLOCK_SECONDS=3600
JWT_ISSUER=vethelp-auth
JWT_AUDIENCE=vethelp-api
WORKER_SERVICE_TOKEN=replace-with-a-long-random-service-token
