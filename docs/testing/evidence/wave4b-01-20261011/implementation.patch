+import type { SchemaObject } from '@nestjs/swagger/dist/interfaces/open-api-spec.interface';
+const uuid: SchemaObject = {type:'string',format:'uuid'};
+const time: SchemaObject = {type:'string',format:'date-time'};
+function closed(properties: Record<string,SchemaObject>): SchemaObject & {properties: Record<string,SchemaObject>} { return {type:'object',additionalProperties:false,required:Object.keys(properties),properties}; }
+export const ocrJobSchema=closed({jobId:uuid,documentId:uuid,petId:uuid,state:{type:'string',enum:['QUEUED','RUNNING','SUCCEEDED','FAILED']},attemptCount:{type:'integer',minimum:0,maximum:3},maxAttempts:{type:'integer',enum:[3]},errorCode:{type:'string',nullable:true,enum:['PROVIDER_FAILED','INVALID_RESULT','LEASE_EXPIRED','SOURCE_UNAVAILABLE','SOURCE_CHANGED']},authority:{type:'string',enum:['UNCONFIRMED']}});
+const extraction:SchemaObject={type:'object',additionalProperties:false,required:['text'],properties:{text:{type:'string',maxLength:32768},provider:{type:'string',maxLength:120},providerVersion:{type:'string',maxLength:80}}};
+export const ocrReadSchema=closed({...ocrJobSchema.properties,attempts:{type:'array',maxItems:3,items:closed({attemptNumber:{type:'integer',minimum:1,maximum:3},status:{type:'string',enum:['RUNNING','SUCCEEDED','FAILED','ABANDONED']},startedAt:time,finishedAt:{...time,nullable:true},errorCode:{...ocrJobSchema.properties!.errorCode}})},result:{...closed({resultId:uuid,sourceIdentity:{type:'string',pattern:'^[0-9a-f]{64}$'},resultIdentity:{type:'string',pattern:'^[0-9a-f]{64}$'},authority:{type:'string',enum:['UNCONFIRMED']},extraction,extractedAt:time,provider:{type:'string',nullable:true},providerVersion:{type:'string',nullable:true},startedAt:time,finishedAt:time,candidate:closed({candidateId:uuid,schemaVersion:{type:'integer',enum:[1]},kind:{type:'string',enum:['EXTRACTED_TEXT']},text:{type:'string',maxLength:32768},reviewState:{type:'string',enum:['PENDING_OWNER_REVIEW']}})}),nullable:true}});
+export const ocrEmptyRequest=closed({});
